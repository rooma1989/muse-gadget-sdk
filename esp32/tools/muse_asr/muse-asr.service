[Unit]
Description=Speech-to-text for Muse gadgets (tools/muse_asr)
After=network-online.target

[Service]
User=museasr
Group=museasr
WorkingDirectory=/opt/muse-asr
Environment=MUSE_ASR_KEY_FILE=/etc/muse-asr/key
Environment=MUSE_ASR_MODEL=/opt/muse-asr/model
Environment=MUSE_ASR_LISTEN=127.0.0.1:8102
ExecStart=/opt/muse-asr/venv/bin/python /opt/muse-asr/app/server.py
Restart=on-failure
RestartSec=3
# The model takes ~300 MB; keep it from crowding out the host's other services.
MemoryMax=700M
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
